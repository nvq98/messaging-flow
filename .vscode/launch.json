  "compounds": [
    {
      "name": "All Services",
      "configurations": [
        "Communication.Api",
        "Inquiries.Api",
        "SLA.Api",
        "SystemMetrics.Api",
        "Tickets.Api",
        "Translations.Api"
      ]
    },
    {
      "name": "Tickets + SLA",
      "configurations": ["Tickets.Api", "SLA.Api"]
    },
    {
      "name": "Only Tickets",
      "configurations": ["Tickets.Api"]
    },
    {
      "name": "Infra + Translation",
      "configurations": ["SystemMetrics.Api", "Translations.Api"]
    },
    {
      "name": "Communication",
      "configurations": ["Communication.Api"]
    }
  ]
