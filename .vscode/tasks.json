{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run Communication.Api",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "pkill -f 'Communication/TicketFlow.Services.Communication.Api/bin/Debug' || true && dotnet run --project ${workspaceFolder}/src/Communication/TicketFlow.Services.Communication.Api/TicketFlow.Services.Communication.Api.csproj"
      ],
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5418"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "run Inquiries.Api",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "pkill -f 'Inquiries/TicketFlow.Services.Inquiries.Api/bin/Debug' || true && dotnet run --project ${workspaceFolder}/src/Inquiries/TicketFlow.Services.Inquiries.Api/TicketFlow.Services.Inquiries.Api.csproj"
      ],
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5011"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "run SLA.Api",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "pkill -f 'SLA/TicketFlow.Services.SLA.Api/bin/Debug' || true && dotnet run --project ${workspaceFolder}/src/SLA/TicketFlow.Services.SLA.Api/TicketFlow.Services.SLA.Api.csproj"
      ],
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5054"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "run SystemMetrics.Api",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "pkill -f 'SystemMetrics/TicketFlow.Services.SystemMetrics.Api/bin/Debug' || true && dotnet run --project ${workspaceFolder}/src/SystemMetrics/TicketFlow.Services.SystemMetrics.Api/TicketFlow.Services.SystemMetrics.Api.csproj"
      ],
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5231"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "run Tickets.Api",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "pkill -f 'Tickets/TicketFlow.Services.Tickets.Api/bin/Debug' || true && dotnet run --project ${workspaceFolder}/src/Tickets/TicketFlow.Services.Tickets.Api/TicketFlow.Services.Tickets.Api.csproj"
      ],
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5112"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "run Translations.Api",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "pkill -f 'Translations/TicketFlow.Services.Translations.Api/bin/Debug' || true && dotnet run --project ${workspaceFolder}/src/Translations/TicketFlow.Services.Translations.Api/TicketFlow.Services.Translations.Api.csproj"
      ],
      "options": {
        "env": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ASPNETCORE_URLS": "http://localhost:5274"
        }
      },
      "problemMatcher": []
    },

    {
      "label": "run All Services",
      "dependsOn": [
        "run Communication.Api",
        "run Inquiries.Api",
        "run SLA.Api",
        "run SystemMetrics.Api",
        "run Tickets.Api",
        "run Translations.Api"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "run Tickets + SLA",
      "dependsOn": ["run Tickets.Api", "run SLA.Api"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "run Only Tickets",
      "dependsOn": ["run Tickets.Api"],
      "problemMatcher": []
    },
    {
      "label": "run Infra + Translation",
      "dependsOn": ["run SystemMetrics.Api", "run Translations.Api"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "run Communication Only",
      "dependsOn": ["run Communication.Api"],
      "problemMatcher": []
    }
  ]
}
