{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "TicketFlow": "Warning",
      "System.Net": "Warning"
    }
  },
  "App": {
    "AppName" : "sla-service"
  },
  "Deduplication": {
    "Enabled": true
  },
  "Observability" : {
    "Enabled" : false,
    "Endpoint" : "http://localhost:4317"
  },
  "Outbox": {
    "Enabled": true,
    "PublishOnCommit" : true,
    "IntervalMilliseconds" : 3000,
    "BatchSize": 1
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Database=TicketFlow.SLA;Username=postgres;Password="
  },
  "rabbitMq": {
    "hostName": "localhost",
    "port": 5672,
    "username": "guest",
    "password": "guest",
    "virtualHost": "/",
    "createTopology": true
  },
  "Services": {
    "Tickets": "http://localhost:5112",
    "Communication": "http://localhost:5148"
  },
  "Metrics": {
    "Enabled": false
  },
  "Resiliency": {
    "Consumer": {
      "BrokerRetriesEnabled": true,
      "BrokerRetriesLimit": 3,
      "ConsumerRetriesEnabled": true,
      "UseDeadletter": true,
      "PublishFaultOnFailure": true,
      "MaxMessagesFetchedPerConsumer": 1
    },
    "Producer": {
      "PublisherConfirmsEnabled":  true,
      "PublishMandatoryEnabled": true
    }
  },
  "OutOfOrderDetection": {
    "Enabled": true
  },
  "Partitioning": {
    "TicketChanges": {
      "NumberOfPartitions": 3
    }
  }
}
